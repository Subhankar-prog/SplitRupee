generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
}

enum Category {
  Food
  Rent
  Travel
  Utilities
  Shopping
  Entertainment
  Miscellaneous
}

enum GroupType {
  TRIP
  HOME
  COUPLE
  OTHER
}

enum ActionType {
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  EXPENSE_RESTORED
  PAYMENT_SETTLED
  MEMBER_ADDED
  MEMBER_REMOVED
  GROUP_CREATED
}

model User {
  id               String         @id @default(uuid())
  name             String
  email            String         @unique
  avatarColor      String         @default("#10b981")
  upiId            String?
  phone            String?
  passwordHash     String?
  createdAt        DateTime       @default(now())
  memberships      GroupMember[]
  paidExpenses     Expense[]      @relation("ExpensePayer")
  splits           ExpenseSplit[]
  sentPayments     Payment[]      @relation("PaymentPayer")
  receivedPayments Payment[]      @relation("PaymentReceiver")
  activityLogs     ActivityLog[]
  itineraries      Itinerary[]
}

model Group {
  id           String        @id @default(uuid())
  name         String
  type         GroupType     @default(OTHER)
  currency     String        @default("INR")
  inviteCode   String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  members      GroupMember[]
  expenses     Expense[]
  payments     Payment[]
  activityLogs ActivityLog[]
  itineraries  Itinerary[]
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Expense {
  id          String         @id @default(uuid())
  groupId     String
  paidById    String
  title       String
  totalAmount Float
  splitType   SplitType      @default(EQUAL)
  category    Category       @default(Miscellaneous)
  notes       String?
  receiptUrl  String?
  isDeleted   Boolean        @default(false)
  deletedAt   DateTime?
  date        DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy      User           @relation("ExpensePayer", fields: [paidById], references: [id])
  splits      ExpenseSplit[]

  @@index([groupId, createdAt])
  @@index([groupId, isDeleted])
}

model ExpenseSplit {
  id         String  @id @default(uuid())
  expenseId  String
  userId     String
  amount     Float
  percentage Float?
  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user       User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@index([userId])
}

model Payment {
  id         String   @id @default(uuid())
  groupId    String
  payerId    String
  receiverId String
  amount     Float
  notes      String?
  createdAt  DateTime @default(now())
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer      User     @relation("PaymentPayer", fields: [payerId], references: [id])
  receiver   User     @relation("PaymentReceiver", fields: [receiverId], references: [id])

  @@index([groupId, createdAt])
}

model ActivityLog {
  id          String     @id @default(uuid())
  groupId     String
  userId      String
  action      ActionType
  entityTitle String
  details     String?
  createdAt   DateTime   @default(now())
  group       Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([userId, createdAt])
}

model Itinerary {
  id          String   @id @default(uuid())
  userId      String?
  groupId     String?
  title       String
  origin      String
  destination String
  startDate   DateTime
  endDate     DateTime
  days        Int
  groupSize   Int
  totalBudget Float
  preferences String
  planData    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([groupId])
}

